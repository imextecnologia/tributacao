{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Edge (localhost:5500)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5500/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Servidor local",
      "postDebugTask": "Parar servidor local"
    },
    {
      "name": "Chrome (localhost:5500)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5500/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Servidor local",
      "postDebugTask": "Parar servidor local"
    },
    {
      "name": "Edge (abrir arquivo, sem servidor)",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
