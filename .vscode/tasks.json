{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servidor local",
      "type": "shell",
      "command": "npx --yes http-server -p 5500 -c-1",
      "isBackground": true,
      "problemMatcher": {
        "owner": "http-server",
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Starting up http-server",
          "endsPattern": "Available on:"
        }
      }
    },
    {
      "label": "Parar servidor local",
      "command": "echo ${input:terminate}",
      "type": "shell",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "Servidor local"
    }
  ]
}
